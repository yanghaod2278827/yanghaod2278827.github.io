{{- $pages := where site.RegularPages "Section" "in" (slice "posts" "notebook" "reading") -}}
[
{{- range $i, $p := $pages }}
  {{- if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "section": {{ (or $p.CurrentSection.Title $p.Section) | jsonify }},
    "date": {{ ($p.Date.Format "2006-01-02") | jsonify }},
    "tags": {{ (or $p.Params.tags slice) | jsonify }},
    "summary": {{ (or $p.Params.summary $p.Summary) | plainify | truncate 200 | jsonify }},
    "text": {{ $p.Plain | truncate 800 | jsonify }}
  }
{{- end }}
]
